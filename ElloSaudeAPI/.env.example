# Copy to .env and replace every value with a unique random secret.
# Keep .env outside version control.
COMPOSE_PROJECT_NAME=ellosaude
MSSQL_SA_PASSWORD=Replace-With-Unique-Strong-SQL-Password-Only
JWT_KEY=Replace-With-At-Least-64-Random-Characters
DEVELOPMENT_SEED_PASSWORD=Replace-With-A-Unique-Password-At-Least-16-Chars
RABBITMQ_DEFAULT_USER=ellosaude
RABBITMQ_DEFAULT_PASS=Replace-With-Another-Unique-Random-Secret
SQLSERVER_PORT=1433
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
API_PORT=5080
FRONTEND_PORT=8088
